# ---------------------------------------------------------------------------
# Telegram Bot Configuration
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN_HERE>

# ---------------------------------------------------------------------------
# PORT (for deployment platforms like Render)
# ---------------------------------------------------------------------------
PORT=8000

# ---------------------------------------------------------------------------
# GOOGLE AI STUDIO (Core/Gemma Mode: gemma-3-27b-it)
# Fallback chain: KEY_1 -> KEY_2 -> KEY_3
# ---------------------------------------------------------------------------
GOOGLE_API_KEY_1=AIzaSy...
GOOGLE_API_KEY_2=AIzaSy...
GOOGLE_API_KEY_3=AIzaSy...

# Optional: Override the Gemma model name
# GEMMA_MODEL=gemma-3-27b-it

# ---------------------------------------------------------------------------
# GROQ (Flash Mode: llama3-8b-8192)
# ---------------------------------------------------------------------------
GROQ_API_KEY_1=gsk_...

# ---------------------------------------------------------------------------
# GITHUB MODELS (Thinking/Pro/Expert Modes)
#   GITHUB_TOKEN_1 -> deepseek-r1    (Thinking Mode)
#   GITHUB_TOKEN_2 -> llama-4-maverick (Expert Mode)
#   GITHUB_TOKEN_3 -> llama-4-scout   (Pro Mode)
# ---------------------------------------------------------------------------
GITHUB_TOKEN_1=ghp_...
GITHUB_TOKEN_2=ghp_...
GITHUB_TOKEN_3=ghp_...

# Optional: Override GitHub Models endpoint
# GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com/chat/completions

# ---------------------------------------------------------------------------
# HUGGING FACE (Flux/Image Mode: black-forest-labs/FLUX.1-schnell)
# Fallback chain: TOKEN_1 -> TOKEN_2
# ---------------------------------------------------------------------------
HF_TOKEN_1=hf_...
HF_TOKEN_2=hf_...
