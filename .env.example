# ============================================================================
# Gemma 3 Neuro-System - environment template
# Copy to `.env` and fill in your keys:  cp .env.example .env
# NEVER commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------------------
# AI providers (fallback order: Google -> Groq -> OpenRouter -> Hugging Face)
# At least ONE key is required.
# ---------------------------------------------------------------------------

# 1) Google AI Studio  -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# 2) Groq              -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3) OpenRouter        -> https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4) Hugging Face      -> https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# 5) GitHub Models     -> https://github.com/settings/tokens
#    Powers 'reasoning' mode (DeepSeek-R1) via the Azure AI inference endpoint.
#    Sent as:  Authorization: Bearer <GITHUB_TOKEN>
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# Private channel used as the JSON database (add the bot as an administrator).
# Supergroup/channel IDs start with -100...
TELEGRAM_CHANNEL_ID=-1001234567890

# ---------------------------------------------------------------------------
# Force Subscribe / channel membership gate
# ---------------------------------------------------------------------------
# Public channel the user MUST join before the bot or Mini App will answer.
# Accepts an @handle or a -100... id. Leave EMPTY to disable the gate entirely.
# The bot must be an ADMINISTRATOR of this channel, otherwise get_chat_member()
# fails and (by default) everyone is blocked.
REQUIRED_CHANNEL_ID=@mychannel

# Link shown on the "Join Channel" button. Auto-derived from an @handle if blank.
CHANNEL_INVITE_LINK=https://t.me/mychannel

# How long a positive/negative membership verdict is cached, in seconds.
MEMBERSHIP_CACHE_TTL=300
MEMBERSHIP_NEGATIVE_TTL=20

# If the membership check itself errors (bot not admin, Telegram down):
#   false = block the user (secure default)   true = let them through
FORCE_SUB_FAIL_OPEN=false

# ---------------------------------------------------------------------------
# Mini App initData validation (anti-spoofing)
# ---------------------------------------------------------------------------
# Mini App requests are authenticated by verifying the HMAC-SHA256 signature of
# window.Telegram.WebApp.initData against TELEGRAM_BOT_TOKEN.

# Reject signed payloads older than this many seconds (replay protection).
# 0 disables the freshness check. Default 86400 (24 hours).
INIT_DATA_MAX_AGE=86400

# LOCAL DEVELOPMENT ONLY. When true and no bot token is set, the API skips
# signature verification so you can test the UI in a plain browser.
# NEVER enable this in production - it disables anti-spoofing entirely.
ALLOW_UNVERIFIED_TMA=false

# ---------------------------------------------------------------------------
# Capability map (optional - defaults shown)
#   flash     -> Groq        (fast, low param)
#   reasoning -> OpenRouter  (step-by-step logic)
#   pro       -> OpenRouter  (heavy coding / expert)
#   core      -> Google AI Studio, Gemma 3 27B  (DEFAULT engine)
#   vision    -> Google AI Studio, Gemma 3 multimodal (all image input)
# ---------------------------------------------------------------------------
# --- Google AI Studio (Core & Vision) --------------------------------------
CORE_MODEL=gemma-3-27b-it
VISION_MODEL=gemma-3-27b-it

# --- Groq (Flash: fast general replies) ------------------------------------
# NOTE: Groq has announced llama-3.3-70b-versatile for shutdown on 2026-08-16
# (replacement: openai/gpt-oss-120b or qwen/qwen3.6-27b). Switch when it stops
# resolving - until then this value is honoured as configured.
FLASH_MODEL=llama-3.3-70b-versatile
# Alternatives:  openai/gpt-oss-20b (~1000 t/s)  |  openai/gpt-oss-120b

# --- OpenRouter (Pro: heavy coding / expert tasks) --------------------------
PRO_MODEL=meta-llama/llama-4-maverick
# Alternatives:  meta-llama/llama-3.3-70b-instruct  |  meta-llama/llama-4-maverick:free
# OpenRouter ':free' tiers come and go - drop the suffix (paid) if requests 404.

# --- GitHub Models / Azure AI (Reasoning: step-by-step logic) ---------------
# Authenticates with a GitHub PAT sent as:  Authorization: Bearer <GITHUB_TOKEN>
# Create one at https://github.com/settings/tokens (the free tier needs no
# special scopes; 'models: read' is required for fine-grained tokens).
REASONING_MODEL=DeepSeek-R1
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com/chat/completions

# Verify live ids before deploying:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#   https://openrouter.ai/models
#   https://github.com/marketplace/models

# Vision requests carry image bytes, so they get a longer timeout.
AI_VISION_TIMEOUT=120
# Largest Telegram photo the bot will download and send to Gemma 3 (bytes).
MAX_IMAGE_BYTES=4194304

# ---------------------------------------------------------------------------
# Legacy fallback-chain model overrides
# ---------------------------------------------------------------------------
GOOGLE_MODEL=gemma-3-27b-it
GROQ_MODEL=gemma-3-12b-it
OPENROUTER_MODEL=google/gemma-3-27b-it:free
HF_MODEL=google/gemma-3-27b-it

# ---------------------------------------------------------------------------
# Generation settings (optional)
# ---------------------------------------------------------------------------
SYSTEM_PROMPT=You are Gemma, a helpful, concise and friendly AI assistant.
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Server & behaviour flags (optional)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
APP_NAME=Gemma 3 Neuro-System

# ---------------------------------------------------------------------------
# Fullstack / CORS (optional)
# ---------------------------------------------------------------------------
# The dashboard is served from the same origin, so CORS is NOT needed for it.
# localhost dev origins are always allowed. Add extra origins comma-separated,
# or set ALLOWED_ORIGINS=* to allow everything (credentials are then disabled).
# ALLOWED_ORIGINS=https://my-dashboard.vercel.app
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Override the static frontend directory (defaults to ./frontend)
# FRONTEND_DIR=frontend

ENABLE_TELEGRAM_BOT=true
LOG_TO_CHANNEL=true
LOG_WEB_TO_CHANNEL=true
BOT_HISTORY_TURNS=6

# OpenRouter attribution headers (optional)
OPENROUTER_SITE_URL=https://your-dashboard.example.com
OPENROUTER_APP_NAME=gemma3-neuro-backend
