# ============================================================================
# Gemma 3 Neuro-System - environment template
# Copy to `.env` and fill in your keys:  cp .env.example .env
# NEVER commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------------------
# AI providers (fallback order: Google -> Groq -> OpenRouter -> Hugging Face)
# At least ONE key is required.
# ---------------------------------------------------------------------------

# 1) Google AI Studio  -> https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# 2) Groq              -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 3) OpenRouter        -> https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4) Hugging Face      -> https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# Private channel used as the JSON database (add the bot as an administrator).
# Supergroup/channel IDs start with -100...
TELEGRAM_CHANNEL_ID=-1001234567890

# ---------------------------------------------------------------------------
# Model overrides (optional - defaults shown)
# ---------------------------------------------------------------------------
GOOGLE_MODEL=gemma-3-27b-it
GROQ_MODEL=gemma-3-12b-it
OPENROUTER_MODEL=google/gemma-3-27b-it:free
HF_MODEL=google/gemma-3-27b-it

# ---------------------------------------------------------------------------
# Generation settings (optional)
# ---------------------------------------------------------------------------
SYSTEM_PROMPT=You are Gemma, a helpful, concise and friendly AI assistant.
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Server & behaviour flags (optional)
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
APP_NAME=Gemma 3 Neuro-System

ENABLE_TELEGRAM_BOT=true
LOG_TO_CHANNEL=true
LOG_WEB_TO_CHANNEL=true
BOT_HISTORY_TURNS=6

# OpenRouter attribution headers (optional)
OPENROUTER_SITE_URL=https://your-dashboard.example.com
OPENROUTER_APP_NAME=gemma3-neuro-backend
