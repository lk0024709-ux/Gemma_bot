# ---------------------------------------------------------------------------
# Telegram Bot Configuration
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN_HERE>
CHANNEL_USERNAME=@yourchannel

# ---------------------------------------------------------------------------
# GOOGLE AI STUDIO TIER (Primary Engine: gemma-3-27b-it)
# Round-robin load balancing is supported across the 3 keys.
# ---------------------------------------------------------------------------
GOOGLE_API_KEY_1=AIzaSy...
GOOGLE_API_KEY_2=AIzaSy...
GOOGLE_API_KEY_3=AIzaSy...

# ---------------------------------------------------------------------------
# GROQ TIER (Ultra-Fast Response: llama-3.1-8b-instant / llama-3.3-70b-versatile)
# ---------------------------------------------------------------------------
GROQ_API_KEY_1=gsk_...

# ---------------------------------------------------------------------------
# GITHUB MODELS TIER (Secondary Fallback Tier: deepseek-r1 / llama-4)
# Round-robin across GitHub tokens when Google AI Studio hits rate limits.
# ---------------------------------------------------------------------------
GITHUB_TOKEN_1=ghp_...
GITHUB_TOKEN_2=ghp_...
GITHUB_TOKEN_3=ghp_...

# ---------------------------------------------------------------------------
# HUGGING FACE TIER (Image Generation Engine: FLUX.1-schnell / FLUX.1-dev)
# Handles /draw and /imagine commands via Hugging Face Inference API.
# ---------------------------------------------------------------------------
HF_TOKEN_1=hf_...
HF_TOKEN_2=hf_...
